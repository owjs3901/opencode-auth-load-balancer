{
  "name": "opencode-auth-load-balancer",
  "version": "0.6.0",
  "description": "Load-balance opencode requests across multiple Anthropic (Claude) and OpenAI (Codex) OAuth accounts and Kimi Code subscriptions, weighted primarily by weekly usage with drain-before-reset scheduling.",
  "type": "module",
  "license": "MIT",
  "author": "owjs3901",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owjs3901/opencode-auth-load-balancer.git"
  },
  "homepage": "https://github.com/owjs3901/opencode-auth-load-balancer#readme",
  "bugs": {
    "url": "https://github.com/owjs3901/opencode-auth-load-balancer/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1.d.ts",
      "default": "./dist/v1.js"
    },
    "./server": "./dist/index.js",
    "./tui": "./tui.ts",
    "./tui-v1": "./tui/auth-load-balancer-tui.ts"
  },
  "files": [
    "index.js",
    "tui.ts",
    "dist",
    "tui"
  ],
  "scripts": {
    "sync:tui": "bun -e \"await Bun.write('tui/auth-load-balancer-scoring.ts', Bun.file('src/scheduler/score-core.ts')); await Bun.write('tui/auth-load-balancer-rpc.ts', Bun.file('src/v2-rpc.ts'))\"",
    "build": "bun run sync:tui && bun build ./src/index.ts ./src/v1.ts --outdir dist --target node --format esm --external @opencode/plugin --external effect --external 'effect/*' && tsc -p tsconfig.build.json",
    "dev": "bun build ./src/index.ts ./src/v1.ts --outdir dist --target node --format esm --external @opencode/plugin --external effect --external 'effect/*' --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tui.json --noEmit",
    "typecheck:tui": "tsc -p tsconfig.tui.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "status": "bun run src/cli/status.ts",
    "changepacks": "bunx @changepacks/cli",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.26 <2",
    "@opencode/plugin": "^2.0.27",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.26",
    "@opencode/plugin": "2.0.27",
    "@opencode/theme": "2.0.27",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "eslint-plugin-devup": "^2.1.0",
    "husky": "^9.1",
    "oxlint": "1.81",
    "solid-js": "1.9.15",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "anthropic",
    "claude",
    "openai",
    "codex",
    "kimi",
    "kimi-code",
    "oauth",
    "load-balancer"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.129",
    "@ai-sdk/openai": "3.0.125",
    "@ai-sdk/openai-compatible": "2.0.81",
    "zod": "^4.3"
  }
}
